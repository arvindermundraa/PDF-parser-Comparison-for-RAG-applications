# Everything here is optional. Extraction with PyMuPDF, Docling and Unstructured needs no settings.

# Local LLM through Ollama (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llama3.2-vision

# Embedding model for retrieval
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L12-v2

# TAMU AI chat API. Only available to Texas A&M users; leave empty to skip this method.
TAMUS_API_KEY=
TAMUS_API_BASE=https://chat-api.tamu.ai
TAMUS_PDF_MODEL=protected.claude-sonnet-4
